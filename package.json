{
  "name": "ordknapp",
  "version": "1.0.0",
  "description": "Ordknapp — daily Swedish word game. Write a clue, a blind AI guesses the word. Golf scoring by clue length.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "test": "node --test \"test/*.test.js\"",
    "check:ai": "node scripts/check-ai.mjs",
    "build:dictionary": "node --max-old-space-size=3000 scripts/build-dictionary.mjs",
    "build:dictionary:en": "node scripts/build-dictionary-en.mjs",
    "build:lemmas:en": "node scripts/build-lemmas-en.mjs",
    "review:words": "node --max-old-space-size=2000 scripts/review-words.mjs",
    "probe": "node scripts/probe-word.mjs",
    "limits": "node scripts/apply-limits.mjs",
    "rotation": "node scripts/rotation.mjs",
    "density": "node scripts/word-density.mjs",
    "migrate:locale": "node scripts/migrate-locale-prefix.mjs",
    "migrate:puzzle": "node scripts/migrate-puzzle-keys.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@vitejs/plugin-react": "^4.7.0",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@cspell/dict-sv": "^2.3.2",
    "word-list": "^3.0.0",
    "cspell-trie-lib": "^10.0.1",
    "dictionary-sv": "^4.0.0",
    "wordnet-db": "^3.1.14"
  }
}
