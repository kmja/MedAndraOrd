  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.0"
  }
}
