{
  "name": "ordknapp",
  "version": "1.0.0",
  "description": "Ordknapp — daily Swedish word game. Write a clue, a blind AI guesses the word. Golf scoring by clue length.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "test": "node --test \"test/*.test.js\"",
    "check:ai": "node scripts/check-ai.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@vitejs/plugin-react": "^4.7.0",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.4.3"
  }
}
