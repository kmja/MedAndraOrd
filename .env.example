# Krävs — hålls på servern, exponeras aldrig mot klienten.
GEMINI_API_KEY=...

# Valfritt
ORDKNAPP_MODEL=gemini-3.1-flash-lite
PORT=3000
ORDKNAPP_DATA=./data/store.json

# Övningsläget ("Slumpa ord") är på som standard. Sätt till 0 för att ta bort
# testknappen ur en publik deploy.
ORDKNAPP_PRACTICE=1

# Krävs vid serverless-deploy (Vercel), där filsystemet inte överlever.
# Injiceras automatiskt av en Upstash/KV-integration. Utan dessa hamnar
# topplista och försöksgräns i minnet och nollställs vid varje kallstart.
# KV_REST_API_URL=https://....upstash.io
# KV_REST_API_TOKEN=...
